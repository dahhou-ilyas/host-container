# Docker Wrapper API - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://user:password@localhost:5432/docker_wrapper?sslmode=disable

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Server port (default: 8000)
PORT=8000

# Base path for project workspaces created for containers
# This is where user project folders will be created
PROJECTS_BASE_PATH=/tmp/projects

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret Key for authentication tokens
# IMPORTANT: Use a strong, random secret in production
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# JWT Token expiration time (in hours)
JWT_EXPIRATION_HOURS=24

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker socket path (usually /var/run/docker.sock on Linux)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Default memory limit for containers (in MB)
DEFAULT_CONTAINER_MEMORY=512

# Default CPU limit for containers (number of cores)
DEFAULT_CONTAINER_CPU=1

# =============================================================================
# MONITORING (Optional - for docker-compose)
# =============================================================================
# Prometheus port
PROMETHEUS_PORT=9090

# Grafana port
GRAFANA_PORT=3000

# =============================================================================
# LOGGING
# =============================================================================
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# =============================================================================
# CORS CONFIGURATION (Optional)
# =============================================================================
# Allowed origins for CORS (comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# =============================================================================
# PRODUCTION NOTES
# =============================================================================
# 1. Never commit .env file to git (already in .gitignore)
# 2. Use strong passwords and secrets in production
# 3. Enable SSL/TLS for database connections in production
# 4. Consider using environment-specific .env files (.env.prod, .env.dev)
# 5. For Kubernetes/Cloud deployments, use secrets management systems
