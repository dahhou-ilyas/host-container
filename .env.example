# ── Application ──────────────────────────────────────────────────────────────
APP_ADDR=:8080
ADMIN_ADDR=:2112
OTEL_SERVICE_NAME=docker-wrapper

# ── Database ─────────────────────────────────────────────────────────────────
# Use sslmode=require in production
DATABASE_URL=postgres://docker_user:CHANGE_ME@localhost:5432/docker_wrapper?sslmode=disable

# ── PostgreSQL (docker-compose only) ─────────────────────────────────────────
POSTGRES_USER=docker_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=docker_wrapper

# ── Authentication ────────────────────────────────────────────────────────────
# Must be at least 32 characters; generate with: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS_LONG_STRING

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ── Containers ───────────────────────────────────────────────────────────────
PROJECTS_BASE_PATH=/tmp/projects
CONTAINER_AUTO_STOP_TIMEOUT=30m
MAX_CONTAINERS_PER_USER=10

# ── Observability ─────────────────────────────────────────────────────────────
# Set to "true" only on internal/developer hosts; never expose in production
ENABLE_PPROF=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Grafana (docker-compose only) ────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
